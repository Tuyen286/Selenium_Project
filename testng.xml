<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Test Suite" parallel="classes" thread-count="2">
    <listeners>
        <listener class-name="com.qa.listeners.TestListener" />
        <listener class-name="com.qa.listeners.RetryTransformer" />
        <listener class-name="com.qa.listeners.TestFilterListener"/>
    </listeners>

    <test name="UI Automation Tests">
        <classes>
            <!-- Path to test class (Package + Class name) -->
            <class name="com.qa.tests.ui.LoginTest"/>
            <class name="com.qa.tests.ui.AlertTest"/>
            <class name="com.qa.tests.ui.CheckboxTest"/>
            <class name="com.qa.tests.ui.DropdownListTest"/>
            <class name="com.qa.tests.ui.DynamicLoadingTest"/>
            <class name="com.qa.tests.ui.FileUploadTest"/>
            <class name="com.qa.tests.ui.FrameTest"/>
            <class name="com.qa.tests.ui.RadioButtonsTest"/>
            <class name="com.qa.tests.ui.StatusCodesTest"/>
            <class name="com.qa.tests.api.UserApiTest"/>
        </classes>
    </test>

</suite>